  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22-latest",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22-latest",
    "@patternfly/react-core": "^6.4.3",
    "@swc/core": "^1.15.40",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "~7.13.1",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4"
  },
  "consolePlugin": {
    "name": "academy-guidance",
