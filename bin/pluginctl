#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_ROOT="${ROOT}/.build"
CHART="${ROOT}/deploy/helm/academy-console-plugin"
RELEASE=academy-guidance
NAMESPACE=academy-console-plugin

usage() {
  cat <<'EOF'
Usage: bin/pluginctl <command> [target]

Commands:
  list                         List supported targets
  prepare <target>             Assemble an isolated build context
  build <target>               Install, typecheck, and build locally
  container-build <target>     Build a locally tagged container with Podman
  image-build <target>         Run the target's OpenShift binary build
  render <target>              Render the Helm chart for the target
  deploy <target>              Install the chart, build, and roll out the target
  clean [target]               Remove one or all generated build contexts

Targets:
  ocp-4.20                     OpenShift 4.20-4.21
  ocp-4.22                     OpenShift 4.22-4.23
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

target_dir() {
  printf '%s/targets/%s' "${ROOT}" "$1"
}

build_dir() {
  printf '%s/%s' "${BUILD_ROOT}" "$1"
}

validate_target() {
  local target="$1"
  [[ "${target}" =~ ^[a-z0-9.-]+$ ]] || die "invalid target name: ${target}"
  [[ -f "$(target_dir "${target}")/target.env" ]] || die "unknown target: ${target}"
}

load_target() {
  local target="$1"
  validate_target "${target}"
  IMAGE_TAG=''
  OPENSHIFT_RANGE=''
  # shellcheck disable=SC1090
  source "$(target_dir "${target}")/target.env"
  [[ -n "${IMAGE_TAG}" ]] || die "IMAGE_TAG is not configured for ${target}"
  # build.enabled: this path builds the image in the cluster. GitOps deploys a built image
  # instead — see deploy/argocd/academy-console-plugin.yaml.
  chart_flags=(
    --namespace "${NAMESPACE}"
    --set "image.tag=${IMAGE_TAG}"
    --set build.enabled=true
  )
}

prepare_target() {
  local target="$1"
  local target_path destination
  load_target "${target}"
  target_path="$(target_dir "${target}")"
  destination="$(build_dir "${target}")"

  rm -rf "${destination}"
  mkdir -p "${destination}/src/platform"
  cp "${ROOT}/Dockerfile" "${ROOT}/.dockerignore" "${ROOT}/.swcrc" \
    "${ROOT}/console-extensions.json" "${ROOT}/tsconfig.json" \
    "${ROOT}/webpack.config.ts" "${destination}/"
  cp "${target_path}/package.json" "${target_path}/package-lock.json" "${destination}/"
  cp -R "${ROOT}/src/." "${destination}/src/"
  cp "${target_path}/elements.ts" "${destination}/src/platform/elements.ts"
  cp "${target_path}/navigation.ts" "${destination}/src/platform/navigation.ts"
  cp "${target_path}/routes.ts" "${destination}/src/platform/routes.ts"

  printf 'Prepared %s for OpenShift %s at %s\n' \
    "${target}" "${OPENSHIFT_RANGE}" "${destination}"
}

target="${2:-}"

case "${1:-help}" in
  list)
    for path in "${ROOT}"/targets/*/target.env; do
      [[ -e "${path}" ]] || continue
      target_name="$(basename "$(dirname "${path}")")"
      load_target "${target_name}"
      printf '%-12s OpenShift %-9s image academy-guidance:%s\n' \
        "${target_name}" "${OPENSHIFT_RANGE}" "${IMAGE_TAG}"
    done
    ;;
  prepare)
    [[ -n "${target}" ]] || die 'target is required'
    prepare_target "${target}"
    ;;
  build)
    [[ -n "${target}" ]] || die 'target is required'
    require_command npm
    prepare_target "${target}"
    (
      cd "$(build_dir "${target}")"
      npm ci
      npm run typecheck
      npm run build
    )
    ;;
  container-build)
    [[ -n "${target}" ]] || die 'target is required'
    require_command podman
    prepare_target "${target}"
    load_target "${target}"
    podman build --tag "academy-guidance:${IMAGE_TAG}" "$(build_dir "${target}")"
    ;;
  image-build)
    [[ -n "${target}" ]] || die 'target is required'
    require_command oc
    prepare_target "${target}"
    oc start-build academy-guidance -n academy-console-plugin \
      --from-dir="$(build_dir "${target}")" --follow
    ;;
  render)
    [[ -n "${target}" ]] || die 'target is required'
    require_command helm
    load_target "${target}"
    helm template "${RELEASE}" "${CHART}" "${chart_flags[@]}" "${@:3}"
    ;;
  deploy)
    [[ -n "${target}" ]] || die 'target is required'
    require_command oc
    require_command helm
    load_target "${target}"
    # The image does not exist before the first build, so the rollout is waited on afterwards
    # rather than by helm --wait.
    helm upgrade --install "${RELEASE}" "${CHART}" --create-namespace \
      "${chart_flags[@]}" "${@:3}"
    prepare_target "${target}"
    oc start-build academy-guidance -n academy-console-plugin \
      --from-dir="$(build_dir "${target}")" --follow
    oc rollout status deployment/academy-guidance \
      -n academy-console-plugin --timeout=5m
    ;;
  clean)
    if [[ -n "${target}" ]]; then
      validate_target "${target}"
      rm -rf "$(build_dir "${target}")"
    else
      rm -rf "${BUILD_ROOT}"
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
