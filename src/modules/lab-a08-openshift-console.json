{
  "$schema": "./module.schema.json",
  "id": "lab-a08-openshift-console",
  "title": "A08 — The OpenShift Console (assisted)",
  "description": "Tour Workloads, Networking, Storage, and configuration using live Academy resources.",
  "completionText": "A08 complete: you located the main resource areas in the OpenShift console.",
  "context": {
    "primaryResource": "academyPortal",
    "resources": {
      "academyPortal": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "label": "Academy portal deployment",
        "listPath": "/k8s/ns/dcs-academy-portal/apps~v1~Deployment",
        "name": "dcs-academy-portal",
        "namespace": "dcs-academy-portal",
        "consolePath": "/k8s/ns/dcs-academy-portal/apps~v1~Deployment/dcs-academy-portal"
      }
    }
  },
  "steps": [
    {
      "id": "open-workloads",
      "title": "Open Workloads",
      "description": "Workloads contains the controllers and Pods that correspond to oc get deployment,pods.",
      "target": { "type": "quickStartId", "value": "qs-nav-workloads" },
      "complete": {
        "operation": { "type": "activateTarget" },
        "verify": { "type": "targetAttribute", "attribute": "aria-expanded", "value": "true" }
      }
    },
    {
      "id": "open-deployments",
      "title": "Open Deployments",
      "description": "Deployments show desired replicas, availability, rollout status, and links to their Pods.",
      "target": { "type": "consoleElement", "id": "navigationLink", "value": "Deployments" },
      "complete": {
        "operation": { "type": "navigate", "path": "/k8s/ns/dcs-academy-portal/apps~v1~Deployment" },
        "verify": { "type": "route", "path": "/k8s/ns/dcs-academy-portal/apps~v1~Deployment" }
      }
    },
    {
      "id": "open-networking",
      "title": "Open Networking",
      "description": "Networking groups stable in-cluster Services and externally reachable Routes.",
      "target": { "type": "quickStartId", "value": "qs-nav-networking" },
      "complete": {
        "operation": { "type": "activateTarget" },
        "verify": { "type": "targetAttribute", "attribute": "aria-expanded", "value": "true" }
      }
    },
    {
      "id": "open-services",
      "title": "Open Services",
      "description": "Services correspond to oc get service and provide stable addresses for changing Pods.",
      "target": { "type": "consoleElement", "id": "navigationLink", "value": "Services" },
      "complete": {
        "operation": { "type": "navigate", "path": "/k8s/ns/dcs-academy-portal/core~v1~Service" },
        "verify": { "type": "route", "path": "/k8s/ns/dcs-academy-portal/core~v1~Service" }
      }
    },
    {
      "id": "open-storage",
      "title": "Open Storage",
      "description": "Storage contains PersistentVolumeClaims with capacity, access mode, class, and bound state.",
      "target": { "type": "quickStartId", "value": "qs-nav-storage" },
      "complete": {
        "operation": { "type": "activateTarget" },
        "verify": { "type": "targetAttribute", "attribute": "aria-expanded", "value": "true" }
      }
    },
    {
      "id": "open-pvcs",
      "title": "Open PersistentVolumeClaims",
      "description": "This view is the visual equivalent of oc get pvc and exposes class and bound status.",
      "target": { "type": "consoleElement", "id": "navigationLink", "value": "PersistentVolumeClaims" },
      "complete": {
        "operation": { "type": "navigate", "path": "/k8s/ns/dcs-academy-portal/core~v1~PersistentVolumeClaim" },
        "verify": { "type": "route", "path": "/k8s/ns/dcs-academy-portal/core~v1~PersistentVolumeClaim" }
      }
    },
    {
      "id": "open-configmaps",
      "title": "Open ConfigMaps",
      "description": "ConfigMaps expose non-secret application configuration, corresponding to oc get configmap.",
      "target": { "type": "consoleElement", "id": "navigationLink", "value": "ConfigMaps" },
      "complete": {
        "operation": { "type": "navigate", "path": "/k8s/ns/dcs-academy-portal/core~v1~ConfigMap" },
        "verify": { "type": "route", "path": "/k8s/ns/dcs-academy-portal/core~v1~ConfigMap" }
      }
    }
  ]
}
