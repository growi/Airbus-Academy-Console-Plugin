{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.example/module.schema.json",
  "title": "Academy console training module",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "completionText", "context", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "completionText": { "type": "string", "minLength": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryResource", "resources"],
      "properties": {
        "primaryResource": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
        "resources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["apiVersion", "kind", "label", "listPath", "name", "namespace", "consolePath"],
            "properties": {
              "apiVersion": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "listPath": { "type": "string", "pattern": "^/" },
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string", "minLength": 1 },
              "consolePath": { "type": "string", "pattern": "^/" },
              "tabs": {
                "type": "object",
                "additionalProperties": { "type": "string", "pattern": "^/" }
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "target", "complete"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": { "const": "quickStartId" },
                  "value": { "type": "string", "pattern": "^[a-z0-9-]+$" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": { "const": "href" },
                  "value": { "type": "string", "pattern": "^/" }
                }
              }
            ]
          },
          "complete": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "verify"],
            "properties": {
              "operation": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type"],
                    "properties": { "type": { "const": "activateTarget" } }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "path"],
                    "properties": {
                      "type": { "const": "navigate" },
                      "path": { "type": "string", "pattern": "^/" }
                    }
                  }
                ]
              },
              "presentation": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["initiator"],
                    "properties": { "initiator": { "const": "continue" } }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["initiator", "delay"],
                    "properties": {
                      "initiator": { "const": "timer" },
                      "delay": { "type": "string", "pattern": "^[0-9]+(ms|s)$" }
                    }
                  }
                ]
              },
              "verify": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "attribute", "value"],
                    "properties": {
                      "type": { "const": "targetAttribute" },
                      "attribute": { "type": "string", "minLength": 1 },
                      "value": { "type": "string" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "path"],
                    "properties": {
                      "type": { "const": "route" },
                      "path": { "type": "string", "pattern": "^/" }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
