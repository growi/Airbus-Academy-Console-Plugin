{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.example/module.schema.json",
  "title": "Academy console training module",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "completionText", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "completionText": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "target", "completeWhen"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": { "const": "quickStartId" },
                  "value": { "type": "string", "pattern": "^[a-z0-9-]+$" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": { "const": "href" },
                  "value": { "type": "string", "pattern": "^/" }
                }
              }
            ]
          },
          "completeWhen": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": { "type": { "const": "click" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": { "const": "route" },
                  "value": { "type": "string", "pattern": "^/" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
