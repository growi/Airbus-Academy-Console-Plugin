{
  "$schema": "./module.schema.json",
  "id": "academy-portal-namespace-filter",
  "title": "Select the Academy namespace (assisted)",
  "description": "Use the namespace selector filter before opening the Academy database pod.",
  "completionText": "Lesson complete: the Academy database pod terminal is open.",
  "context": {
    "primaryResource": "academyDatabase",
    "resources": {
      "academyDatabase": {
        "apiVersion": "v1",
        "kind": "Pod",
        "label": "Academy database pod",
        "listPath": "/k8s/ns/dcs-academy-portal/core~v1~Pod",
        "name": "dcs-academy-portal-db-1",
        "namespace": "dcs-academy-portal",
        "consolePath": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1",
        "tabs": {
          "logs": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1/logs",
          "terminal": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1/terminal"
        }
      }
    }
  },
  "steps": [
    {
      "id": "open-workloads",
      "title": "Open Workloads",
      "description": "Expand Workloads to access the Pods view used to inspect running applications.",
      "target": { "type": "quickStartId", "value": "qs-nav-workloads" },
      "complete": {
        "operation": { "type": "activateTarget" },
        "verify": { "type": "targetAttribute", "attribute": "aria-expanded", "value": "true" }
      }
    },
    {
      "id": "open-all-pods",
      "title": "Open Pods across all projects",
      "description": "Open the cluster-wide Pods list so you can narrow the view with the project selector.",
      "target": { "type": "href", "value": "/k8s/ns/dcs-academy-portal/core~v1~Pod" },
      "complete": {
        "operation": { "type": "navigate", "path": "/k8s/all-namespaces/core~v1~Pod" },
        "verify": { "type": "route", "path": "/k8s/all-namespaces/core~v1~Pod" }
      }
    },
    {
      "id": "open-namespace-selector",
      "title": "Open the project selector",
      "description": "Open the project selector above the Pods list to choose which namespace is shown.",
      "target": { "type": "consoleElement", "id": "namespaceSelector" },
      "complete": {
        "operation": { "type": "activateTarget" },
        "verify": { "type": "targetAttribute", "attribute": "aria-expanded", "value": "true" }
      }
    },
    {
      "id": "filter-namespaces",
      "title": "Filter for Academy namespaces",
      "description": "Type academy into the project filter to reduce the available namespace choices.",
      "target": { "type": "consoleElement", "id": "namespaceFilter" },
      "complete": {
        "operation": { "type": "fillTarget", "value": "academy" },
        "verify": { "type": "targetValue", "value": "academy" }
      }
    },
    {
      "id": "select-academy-namespace",
      "title": "Select dcs-academy-portal",
      "description": "Select dcs-academy-portal to scope the Pods list to the Academy portal project.",
      "target": {
        "type": "consoleElement",
        "id": "namespaceOption",
        "value": "dcs-academy-portal"
      },
      "complete": {
        "operation": { "type": "activateTarget" },
        "verify": { "type": "namespace", "value": "dcs-academy-portal" }
      }
    },
    {
      "id": "open-pod",
      "title": "Open the Academy database pod",
      "description": "Open dcs-academy-portal-db-1 to inspect its status, logs, and containers.",
      "target": { "type": "href", "value": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1" },
      "complete": {
        "operation": { "type": "navigate", "path": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1" },
        "verify": { "type": "route", "path": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1" }
      }
    },
    {
      "id": "open-logs",
      "title": "Inspect the logs",
      "description": "Open Logs as the safest first source of evidence for a running workload.",
      "target": { "type": "href", "value": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1/logs" },
      "complete": {
        "operation": { "type": "navigate", "path": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1/logs" },
        "verify": { "type": "route", "path": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1/logs" }
      }
    },
    {
      "id": "open-terminal",
      "title": "Open the container terminal",
      "description": "Open Terminal to reach the selected pod, using interactive access carefully.",
      "target": { "type": "href", "value": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1/terminal" },
      "complete": {
        "operation": { "type": "navigate", "path": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1/terminal" },
        "verify": { "type": "route", "path": "/k8s/ns/dcs-academy-portal/pods/dcs-academy-portal-db-1/terminal" }
      }
    }
  ]
}
